{
  "name": "coldchain-compliance",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "generate": "node generator/index.js",
    "validate": "node generator/validateData.js",
    "evaluate": "node engine/cli.js",
    "reproduce": "node scripts/reproduce.js",
    "stats": "node scripts/stats.js",
    "export:sql": "node scripts/export.js --format=sql",
    "export:json": "node scripts/export.js --format=json",
    "perf": "node scripts/perf.js",
    "full:manifest": "node scripts/full.js",
    "metrics": "node evaluation/cli.js",
    "export:full": "node scripts/full.js",
    "report": "node engine/reportCli.js",
    "report:examples": "node scripts/reportExamples.js",
    "db:build": "node server/build.js",
    "start": "node server/index.js",
    "bench:api": "node scripts/apiBench.js",
    "client:install": "npm --prefix client install",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
